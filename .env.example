# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — your API key stays local.

# Required: Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender in Resend (use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=TechMorph Contact <onboarding@resend.dev>

# Inbox where contact form submissions are delivered
CONTACT_TO_EMAIL=techmorphpvt@gmail.com